# For docker compose. Make each secret long and random, e.g. `openssl rand -hex 32`.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# What `npm run push-specs` sends to upload the test case files.
SYNC_TOKEN=
# What the runner agents on testers' laptops send (agent/.env RUNNER_TOKEN).
RUNNER_TOKEN=
# Where the app is served on this machine.
PORT=8080
# Where MySQL listens on this machine (127.0.0.1 only), for local development.
MYSQL_PORT=3307
