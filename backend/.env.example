# Postgres connection
DATABASE_URL=postgres://localhost:5432/test_manager

PORT=4000

# Optional. A local specs folder to read and watch: the test cases are synced on start and again
# whenever a test-cases.md file changes. Leave empty where the folder isn't on the same machine.
SPECS_DIR=../../ai-qa/specs

# Optional. The ai-qa checkout whose pytest tests the app runs; defaults to the folder above SPECS_DIR.
# Without it (or without its .venv) the Run buttons are off.
AI_QA_DIR=
# Optional. The Python that has pytest and Playwright; defaults to <AI_QA_DIR>/.venv/bin/python.
AI_QA_PYTHON=

# Optional. Where run reports keep their failure screenshots; defaults to backend/storage/reports.
REPORTS_DIR=

# Optional. Required in the x-sync-token header of POST /api/sync. While empty, that endpoint is off.
SYNC_TOKEN=

# Optional. Comma-separated origins allowed to call the API from a browser (the deployed frontend).
CORS_ORIGIN=
