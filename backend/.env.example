# Postgres connection
DATABASE_URL=postgres://localhost:5432/test_manager

PORT=4000

# Optional. false when migrations run as their own deploy step (npm run migrate) instead of on start.
MIGRATIONS_RUN=true

# Optional, for local development. A specs folder on this machine to read and watch: the test cases are
# synced on start and again whenever a test-cases.md file changes. Leave empty on a deployed backend;
# send the specs with `npm run push-specs` instead.
SPECS_DIR=../../ai-qa/specs

# Required in the x-sync-token header of POST /api/sync (npm run push-specs). While empty, that endpoint is off.
SYNC_TOKEN=

# Required in the x-runner-token header of the runner agents (agent/). While empty, no laptop can run tests.
RUNNER_TOKEN=

# Optional. Comma-separated origins allowed to call the API from a browser, when the frontend is served
# from another address. Not needed behind the Docker frontend, which serves the API on the same address.
CORS_ORIGIN=
