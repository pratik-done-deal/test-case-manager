# ${BACKEND_URL} is filled in when the container starts; nginx's own $variables are left alone.
server {
  listen 8080;
  root /usr/share/nginx/html;

  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    # Server-sent events (/api/events) must reach the page as they happen, and stay open.
    proxy_buffering off;
    proxy_read_timeout 1h;
    # Runner agents send failure screenshots; a spec sync sends every test-cases.md at once.
    client_max_body_size 25m;
  }

  # Built files have hashed names and never change; index.html must always be fresh.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
