# The deployed Test Manager API, e.g. https://test-manager.example.com/api
API_URL=http://localhost:4000/api

# The backend's RUNNER_TOKEN.
RUNNER_TOKEN=

# How this laptop shows in the app's runner picker. Defaults to the computer's name.
RUNNER_NAME=

# Your ai-qa checkout, with its .venv (pytest and Playwright installed).
AI_QA_DIR=../../ai-qa

# Optional. The Python that has pytest and Playwright; defaults to <AI_QA_DIR>/.venv/bin/python.
AI_QA_PYTHON=
